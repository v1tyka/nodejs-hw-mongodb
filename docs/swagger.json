    "/auth/get-oauth-url": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get oauth url",
        "operationId": "GetOauthUrl",
        "description": "Get oauth url",
        "security": [],
        "responses": {
          "200": {
            "description": "Get oauth url",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully send get oauth url!"
                    },
                    "data": {
                      "type": "object",
                      "example": "https://accounts.google.com/o/oauth2/v2/auth?scope=https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fuserinfo.email%20https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fuserinfo.profile&response_type=code&client_id=153300193821-aat5a7bikcvqni6ipblup4ohgu6ra2a3.apps.googleusercontent.com&redirect_uri=h"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          }
        }
      }
    },
    "/auth/confirm-oauth": {
      "post": {
        "tags": ["Auth"],
        "summary": "Confirm Oauth",
        "operationId": "ConfirmOauth",
        "description": "Confirm Oauth",
        "security": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": {
                  "code": {
                    "description": "User's code oauth",
                    "type": "string",
                    "example": "%3D%3D&"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirm Oauth",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "message", "data"],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully confirm oauth!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/sessions"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": ["name", "phoneNumber", "contactType"],
        "properties": {
          "name": {
            "description": "Contact name",
            "type": "string",
            "example": "Jhon Doe"
          },
          "phoneNumber": {
            "description": "Contact phone number",
            "type": "string",
            "example": "+380993457876"
          },
          "email": {
            "description": "Contact email",
            "type": "string",
            "example": "panel@gmail.com"
          },
          "isFavourite": {
            "description": "Contact favourite",
            "type": "boolean",
            "example": false,
            "default": false
          },
          "contactType": {
            "description": "Contact type",
            "type": "string",
            "enum": ["work", "home", "personal"]
          },
          "userId": {
            "description": "Contact user id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "photo": {
            "description": "Contact photo",
            "type": "string",
            "example": "https://res.cloudinary.com/uqwgdu/image/upload/image.png"
          }
        }
      },
      "users": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": {
            "description": "User name",
            "type": "string",
            "example": "Jhon Doe"
          },
          "email": {
            "description": "User email",
            "type": "string",
            "example": "panel@gmail.com"
          },
          "password": {
            "description": "User password",
            "type": "string",
            "example": "12345"
          }
        }
      },
      "sessions": {
        "type": "object",
        "required": [
          "accessToken",
          "refreshToken",
          "accessTokenValidUntil",
          "refreshTokenValidUntil"
        ],
        "properties": {
          "userId": {
            "description": "User id",
            "type": "string",
            "example": "65e4decdd286b30065d54af9"
          },
          "accessToken": {
            "description": "User accessToken",
            "type": "string",
            "example": "gx1ZCy7wsTQZLa2HwbJ6ArhG+F0LofAn59GYTkH6"
          },
          "refreshToken": {
            "description": "User refreshToken",
            "type": "string",
            "example": "6cxi1eeY20QW79wfPVXPpdmAH%2FeIsGWA3s15Pw5F"
          },
          "accessTokenValidUntil": {
            "description": "User accessToken time expiring",
            "type": "string",
            "example": "Sat, 15 Nov 2025 17:54:16 GMT"
          },
          "refreshTokenValidUntil": {
            "description": "User refreshToken time expiring",
            "type": "string",
            "example": "Sat, 15 Nov 2025 17:54:16 GMT"
          }
        }
      }
    },
    "responses": {
      "401": {
        "description": "Unauthorized error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 401
                },
                "message": {
                  "type": "string",
                  "example": "UnauthorizedError"
                },
                "data": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Access token expired"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "404": {
        "description": "User not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["status", "message", "data"],
              "properties": {
                "status": {
                  "type": "integer",
                  "example": 404
                },
                "message": {
                  "type": "string",
                  "example": "UserNotFoundError"
                },
                "data": {
                  "type": "object",
                  "required": ["message"],
                  "properties": {
